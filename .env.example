# Copier vers .env puis adapter. Toutes les variables sont préfixées RAG_SOURCE_.
# Les valeurs ci-dessous sont les défauts, adaptés à la pile Docker Compose.

# ── Corpus ───────────────────────────────────────────────────────────────────
RAG_SOURCE_DATA_DIR=data

# ── API ──────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
RAG_SOURCE_API_TOKEN=

# ── Modèles auto-hébergés ────────────────────────────────────────────────────
RAG_SOURCE_EMBED_URL=http://embed:8080
RAG_SOURCE_RERANK_URL=http://rerank:8080

# ── LLM de génération ────────────────────────────────────────────────────────
# "local" : serveur compatible OpenAI auto-hébergé (défaut, souverain).
RAG_SOURCE_LLM_PROVIDER=local
RAG_SOURCE_LLM_BASE_URL=http://llm:8080/v1
RAG_SOURCE_LLM_MODEL=local
RAG_SOURCE_LLM_CONTEXT_SIZE=8192
RAG_SOURCE_LLM_MAX_TOKENS=1024
RAG_SOURCE_LLM_TEMPERATURE=0.1

# LLM externe : permis par défaut (outil générique), mais les extraits du corpus
# quittent alors l'hôte. Le mode effectif est toujours visible dans /health.
# RAG_SOURCE_LLM_PROVIDER=anthropic
# RAG_SOURCE_LLM_API_KEY=

# Déploiement souverain : refuse de démarrer si le LLM n'est pas local.
# Posé automatiquement par le profil Scaleway (deploy/scaleway).
# RAG_SOURCE_REQUIRE_LOCAL_LLM=true
# Acquittement, uniquement si l'on veut malgré tout un LLM externe dans ce mode :
# RAG_SOURCE_ALLOW_EXTERNAL_LLM=i-understand-data-leaves-the-host

# ── OCR (PDF scannés) ────────────────────────────────────────────────────────
# auto (défaut) : seules les pages sans texte passent par Tesseract.
RAG_SOURCE_OCR_MODE=auto
RAG_SOURCE_OCR_LANGUAGES=eng+fra

# ── Base vectorielle ─────────────────────────────────────────────────────────
RAG_SOURCE_QDRANT_URL=http://qdrant:6333
RAG_SOURCE_QDRANT_API_KEY=
RAG_SOURCE_QDRANT_COLLECTION=rag_source
