# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage

# Secrets
.env
*.env
!*.env.example
!.env.example

# Corpus : peut contenir des documents Diffusion Restreinte, jamais versionné.
data/*
!data/.gitkeep

# Modèles GGUF (plusieurs Go, téléchargés par scripts/fetch-models.sh)
models/*
!models/.gitkeep

# OpenTofu (état et identifiants ne doivent jamais être versionnés)
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
deploy/**/.env
backup/

# Éditeurs / OS
.vscode/
.idea/
*.swp
.DS_Store
