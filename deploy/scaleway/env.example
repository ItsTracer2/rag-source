# Identifiants Scaleway, lus par le provider OpenTofu depuis l'environnement.
#
#   cp env.example .env && $EDITOR .env && source .env
#
# Les créer dans la console Scaleway : IAM → Clés API.
# Ce fichier ne doit jamais être versionné (cf. .gitignore).

export SCW_ACCESS_KEY="SCWXXXXXXXXXXXXXXXXX"
export SCW_SECRET_KEY="00000000-0000-0000-0000-000000000000"
export SCW_DEFAULT_PROJECT_ID="00000000-0000-0000-0000-000000000000"
export SCW_DEFAULT_REGION="fr-par"
export SCW_DEFAULT_ZONE="fr-par-1"
